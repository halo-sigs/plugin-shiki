{
  "scripts": {
    "build": "pnpm -r run build",
    "build:theme-lib": "pnpm -C theme-lib build",
    "build:ui": "pnpm -C ui build",
    "check": "biome check --write",
    "prepare": "cd .. && packages/node_modules/.bin/husky",
    "publish": "pnpm -r publish --access public --no-git-checks"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@shikijs/transformers": "^4.5.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.15.0"
}
